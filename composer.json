{
    "name": "itemvirtual/laravel-2fa",
    "description": "Laravel login with Two-factor authentication (2FA)",
    "keywords": [
        "itemvirtual",
        "laravel-2fa"
    ],
    "homepage": "https://github.com/itemvirtual/laravel-2fa",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sergio",
            "email": "sergio@itemvirtual.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "bacon/bacon-qr-code": "^2.0|^3.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "pragmarx/google2fa": "^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Itemvirtual\\Laravel2fa\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Itemvirtual\\Laravel2fa\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"

    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Itemvirtual\\Laravel2fa\\Laravel2faServiceProvider"
            ],
            "aliases": {
                "Laravel2fa": "Itemvirtual\\Laravel2fa\\Laravel2faFacade"
            }
        }
    }
}
